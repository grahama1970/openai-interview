{
  "version": 2,
  "skill": "openai-interview-control-plane",
  "trials": 3,
  "proof_scope": "Claim-based and seam-based checks for the Memory-native FastAPI control plane, live Memory recall/persistence, bounded Hack SAST scan, Terraform handoff, React qid surface, and hot-reload dev loop.",
  "claims": {
    "proves": "the declared OpenAI interview control-plane seams have repeated deterministic or live guards, including a live Hack SAST scan that detects CWE-78 and persists the scan receipt to Memory",
    "does_not_prove": "OpenAI/Astra internals, Azure deployment, full live Hack session-audit/scanning, Terraform apply, or production readiness"
  },
  "capability_claims": [
    {
      "id": "openai_interview.contracts",
      "description": "Pydantic contracts, auth gate, and Memory-first batch shape validate through project tests.",
      "criticality": "critical",
      "evidence_required": {
        "deterministic": true
      }
    },
    {
      "id": "openai_interview.memory_native",
      "description": "The service calls Memory endpoints for recall and stores eval receipts through Memory with independent readback.",
      "criticality": "critical",
      "evidence_required": {
        "deterministic": true,
        "live_e2e": true
      }
    },
    {
      "id": "openai_interview.hack_scan_boundary",
      "description": "The Hack integration runs a bounded SAST scan through FastAPI, detects a known CWE-78 bug, and stores a Memory receipt with readback.",
      "criticality": "critical",
      "evidence_required": {
        "live_e2e": true
      }
    },
    {
      "id": "openai_interview.terraform_handoff",
      "description": "Terraform is present only as a check/plan handoff and validates without apply.",
      "criticality": "critical",
      "evidence_required": {
        "deterministic": true
      }
    },
    {
      "id": "openai_interview.ui_and_dev_loop",
      "description": "The React surface has qid affordances and the FastAPI/Vite dev loop serves both sides.",
      "criticality": "critical",
      "evidence_required": {
        "deterministic": true,
        "live_e2e": true
      }
    }
  ],
  "seams": [
    {
      "seam_id": "contracts.pydantic_validation",
      "seam_type": "pure deterministic transform",
      "criticality": "critical",
      "claim_id": "openai_interview.contracts",
      "required_evidence": [
        "deterministic"
      ]
    },
    {
      "seam_id": "memory.recall_endpoint",
      "seam_type": "external HTTP/API/provider",
      "criticality": "critical",
      "claim_id": "openai_interview.memory_native",
      "required_evidence": [
        "live_e2e"
      ]
    },
    {
      "seam_id": "memory.persist_readback",
      "seam_type": "persistent state/database/index",
      "criticality": "critical",
      "claim_id": "openai_interview.memory_native",
      "required_evidence": [
        "live_e2e"
      ]
    },
    {
      "seam_id": "dependency.no_postgres",
