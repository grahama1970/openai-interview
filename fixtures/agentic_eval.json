      "claim_id": "openai_interview.memory_native",
      "required_evidence": [
        "deterministic"
      ]
    },
    {
      "seam_id": "hack.verify_endpoint",
      "seam_type": "security/compliance/human-authority",
      "criticality": "critical",
      "claim_id": "openai_interview.hack_scan_boundary",
      "required_evidence": [
        "live_e2e"
      ]
    },
    {
      "seam_id": "terraform.check_handoff",
      "seam_type": "filesystem/process",
      "criticality": "critical",
      "claim_id": "openai_interview.terraform_handoff",
      "required_evidence": [
        "deterministic"
      ]
    },
    {
      "seam_id": "ui.data_qid",
      "seam_type": "browser/UI transport",
      "criticality": "critical",
      "claim_id": "openai_interview.ui_and_dev_loop",
      "required_evidence": [
        "deterministic"
      ]
    },
    {
      "seam_id": "dev.hot_reload",
