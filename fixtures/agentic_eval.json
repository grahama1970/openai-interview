      "required_evidence": [
        "live_e2e"
      ]
    }
  ],
  "cases": [
    {
      "name": "verify-script",
      "type": "positive",
      "evidence_class": "deterministic",
      "real_world": true,
      "supports_claims": [
        "openai_interview.contracts",
        "openai_interview.memory_native",
        "openai_interview.terraform_handoff",
        "openai_interview.ui_and_dev_loop"
      ],
      "seams": [
        "contracts.pydantic_validation",
        "terraform.check_handoff",
        "ui.data_qid"
      ],
      "command": [
        "bash",
        "../scripts/verify.sh"
      ],
      "expected": {
        "exit_code": 0,
        "stdout_contains": [
          "openai_interview.verify.v1",
          "PASS",
          "PYTHON_STANDARDS_OK",
          "ops_terraform.check.v1"
        ]
      },
      "timeout_seconds": 180
    },
