# Local .terraform directories
**/.terraform/*

# State files contain secrets — never commit them
*.tfstate
*.tfstate.*

# Crash logs
crash.log
crash.*.log

# Real variable values (commit only *.tfvars.example)
*.tfvars
*.tfvars.json
!*.tfvars.example

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Plan output files
*.tfplan

# CLI config
.terraformrc
terraform.rc
